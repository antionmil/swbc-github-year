# Fine-grained token, PUBLIC READ-ONLY. No repo scope.
# GraphQL needs auth; REST /events cannot produce a year (90 days / 300 events cap).
# A server-side token returns the same PUBLIC data OAuth would, with no consent
# screen - private contributions are excluded either way.
GITHUB_TOKEN=

NEXT_PUBLIC_SITE_NAME=A Year in Commits
NEXT_PUBLIC_SITE_URL=https://github-year-in-commits.onedaybuilt.com

# Leaderboard (optional). Without these the site runs exactly as before,
# just with no leaderboard. Supabase -> Project Settings -> API.
# The SERVICE ROLE key bypasses RLS - server-only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
